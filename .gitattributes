# Единые переводы строк в репозитории: LF для исходников, CRLF для PowerShell-скриптов.
* text=auto eol=lf

*.rs      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.ps1     text eol=crlf
*.py      text eol=lf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.zip     binary
*.tar.gz  binary
*.exe     binary
